{
  "name": "pheme-review-channel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "broker": "node dist/broker.js",
    "bridge": "node dist/bridge.js",
    "provision": "node dist/provision.js"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.32.2", "zod": "^4.6.7" },
  "devDependencies": { "@types/node": "^22.15.0", "typescript": "^5.9.3" }
}
