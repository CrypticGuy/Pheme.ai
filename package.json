{
  "name": "pheme-review-channel",
  "version": "0.1.0",
  "description": "Ask a real person for a review from inside Claude Code. Only that person can give the verdict.",
  "license": "MIT",
  "author": "Vasu Goel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrypticGuy/Pheme.ai.git"
  },
  "homepage": "https://github.com/CrypticGuy/Pheme.ai#readme",
  "bugs": {
    "url": "https://github.com/CrypticGuy/Pheme.ai/issues"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "code-review",
    "human-in-the-loop",
    "ai-agents"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node -e \"for (const f of ['cli','claude-pheme','bridge']) require('node:fs').chmodSync('dist/'+f+'.js',0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "broker": "node dist/broker.js",
    "bridge": "node dist/bridge.js",
    "provision": "node dist/provision.js",
    "supabase:start": "npx supabase start -x realtime,storage-api,imgproxy,mailpit,studio,logflare,vector,supavisor,postgres-meta",
    "supabase:serve": "npx supabase functions serve --no-verify-jwt",
    "smoke:supabase": "npm run build && node dist/smoke-supabase.js",
    "pheme": "node dist/cli.js",
    "smoke:auth": "npm run build && node dist/smoke-auth.js",
    "e2e:supabase": "npm run build && node dist/e2e-supabase.js",
    "admin": "node dist/admin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "pheme": "dist/cli.js",
    "claude-pheme": "dist/claude-pheme.js"
  },
  "files": [
    "dist",
    "skills",
    "!dist/*.test.js",
    "!dist/smoke-*.js",
    "!dist/e2e-*.js"
  ]
}
